{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"customManagers": [
		{
			"customType": "regex",
			"description": "Update runner release assets and checksums together.",
			"managerFilePatterns": [
				"/^Casks/runner\\.rb$/"
			],
			"matchStrings": [
				"(?<indentation>[ \\t]+)version \"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\r?\\n[ \\t]+sha256 \"(?<currentDigest>[a-f0-9]{64})\""
			],
			"depNameTemplate": "kjanat/runner",
			"datasourceTemplate": "github-release-attachments",
			"versioningTemplate": "semver",
			"currentValueTemplate": "v{{{version}}}",
			"autoReplaceStringTemplate": "{{{indentation}}}version \"{{{replace '^v' '' newValue}}}\"\n{{{indentation}}}sha256 \"{{{newDigest}}}\""
		},
		{
			"customType": "regex",
			"description": "Update svg release assets and checksums together.",
			"managerFilePatterns": [
				"/^Casks/svg\\.rb$/"
			],
			"matchStrings": [
				"(?<indentation>[ \\t]+)version \"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\r?\\n[ \\t]+sha256 \"(?<currentDigest>[a-f0-9]{64})\""
			],
			"depNameTemplate": "kjanat/svg",
			"datasourceTemplate": "github-release-attachments",
			"versioningTemplate": "semver",
			"currentValueTemplate": "v{{{version}}}",
			"autoReplaceStringTemplate": "{{{indentation}}}version \"{{{replace '^v' '' newValue}}}\"\n{{{indentation}}}sha256 \"{{{newDigest}}}\""
		},
		{
			"customType": "regex",
			"description": "Update rshellcheck release assets and checksums together.",
			"managerFilePatterns": [
				"/^Casks/rshellcheck\\.rb$/"
			],
			"matchStrings": [
				"(?<indentation>[ \\t]+)version \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\r?\\n[ \\t]+sha256 \"(?<currentDigest>[a-f0-9]{64})\"\\r?\\n[ \\t]+url \"https://github\\.com/kjanat/shellcheck-rs/releases/download/rshellcheck-v#\\{version\\}/rshellcheck-#\\{version\\}-(?<target>[a-z0-9_-]+)\\.tar\\.gz\""
			],
			"depNameTemplate": "kjanat/shellcheck-rs",
			"datasourceTemplate": "custom.rshellcheck",
			"versioningTemplate": "semver",
			"packageNameTemplate": "{{{target}}}"
		},
		{
			"customType": "regex",
			"description": "Update envctl release assets and checksums together.",
			"managerFilePatterns": [
				"/^Casks/envctl\\.rb$/"
			],
			"matchStrings": [
				"(?<indentation>[ \\t]+)version \"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\r?\\n[ \\t]+sha256 \"(?<currentDigest>[a-f0-9]{64})\""
			],
			"depNameTemplate": "kjanat/envctl",
			"datasourceTemplate": "github-release-attachments",
			"versioningTemplate": "semver",
			"currentValueTemplate": "v{{{version}}}",
			"autoReplaceStringTemplate": "{{{indentation}}}version \"{{{replace '^v' '' newValue}}}\"\n{{{indentation}}}sha256 \"{{{newDigest}}}\""
		},
		{
			"customType": "regex",
			"description": "Update fsql release assets and checksums together.",
			"managerFilePatterns": [
				"/^Casks/fsql\\.rb$/"
			],
			"matchStrings": [
				"(?<indentation>[ \\t]+)version \"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\r?\\n[ \\t]+sha256 \"(?<currentDigest>[a-f0-9]{64})\""
			],
			"depNameTemplate": "kjanat/fsql",
			"datasourceTemplate": "github-release-attachments",
			"versioningTemplate": "semver",
			"currentValueTemplate": "v{{{version}}}",
			"autoReplaceStringTemplate": "{{{indentation}}}version \"{{{replace '^v' '' newValue}}}\"\n{{{indentation}}}sha256 \"{{{newDigest}}}\""
		},
		{
			"customType": "regex",
			"description": "Update each ShellCheck release asset and its checksum together.",
			"managerFilePatterns": [
				"/^Casks/shellcheck\\.rb$/"
			],
			"matchStrings": [
				"(?<indentation>[ \\t]+)version \"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\r?\\n[ \\t]+sha256 \"(?<currentDigest>[a-f0-9]{64})\""
			],
			"depNameTemplate": "koalaman/shellcheck",
			"datasourceTemplate": "github-release-attachments",
			"versioningTemplate": "semver",
			"currentValueTemplate": "v{{{version}}}",
			"autoReplaceStringTemplate": "{{{indentation}}}version \"{{{replace '^v' '' newValue}}}\"\n{{{indentation}}}sha256 \"{{{newDigest}}}\""
		},
		{
			"customType": "regex",
			"description": "Keep the completion headers aligned with the ShellCheck cask.",
			"managerFilePatterns": [
				"/^completions/shellcheck/(bash/shellcheck|fish/shellcheck\\.fish|zsh/_shellcheck|powershell/shellcheck\\.ps1)$/"
			],
			"matchStrings": [
				"# ShellCheck (?<version>[0-9]+\\.[0-9]+\\.[0-9]+)"
			],
			"depNameTemplate": "koalaman/shellcheck",
			"datasourceTemplate": "github-releases",
			"versioningTemplate": "semver",
			"currentValueTemplate": "v{{{version}}}",
			"autoReplaceStringTemplate": "# ShellCheck {{{replace '^v' '' newValue}}}"
		}
	],
	"packageRules": [
		{
			"matchManagers": [
				"custom.regex"
			],
			"matchPackageNames": [
				"kjanat/runner"
			],
			"groupName": "runner cask",
			"minimumGroupSize": 4,
			"automerge": false
		},
		{
			"matchManagers": [
				"custom.regex"
			],
			"matchPackageNames": [
				"kjanat/svg"
			],
			"groupName": "svg cask",
			"minimumGroupSize": 4,
			"automerge": true,
			"platformAutomerge": false,
			"automergeStrategy": "squash"
		},
		{
			"matchManagers": [
				"custom.regex"
			],
			"groupName": "rshellcheck cask",
			"minimumGroupSize": 4,
			"automerge": false,
			"matchDatasources": [
				"custom.rshellcheck"
			]
		},
		{
			"matchManagers": [
				"custom.regex"
			],
			"matchPackageNames": [
				"kjanat/envctl"
			],
			"groupName": "envctl cask",
			"minimumGroupSize": 4,
			"automerge": false
		},
		{
			"matchManagers": [
				"custom.regex"
			],
			"matchPackageNames": [
				"kjanat/fsql"
			],
			"groupName": "fsql cask",
			"minimumGroupSize": 4,
			"automerge": false
		},
		{
			"matchManagers": [
				"custom.regex"
			],
			"matchPackageNames": [
				"koalaman/shellcheck"
			],
			"groupName": "ShellCheck cask and completions",
			"minimumGroupSize": 8,
			"automerge": false
		}
	],
	"customDatasources": {
		"rshellcheck": {
			"defaultRegistryUrlTemplate": "https://api.github.com/repos/kjanat/shellcheck-rs/releases?per_page=100",
			"transformTemplates": [
				"($target := \"{{{packageName}}}\"; {\"sourceUrl\": \"https://github.com/kjanat/shellcheck-rs\", \"releases\": [ $[draft = false and prerelease = false and $contains(tag_name, /^rshellcheck-v[0-9]+\\.[0-9]+\\.[0-9]+$/)].($v := $substringAfter(tag_name, \"rshellcheck-v\"); $prefix := \"rshellcheck-\" & $v & \"-\"; $targets := [\"aarch64-apple-darwin\", \"x86_64-apple-darwin\", \"aarch64-unknown-linux-musl\", \"x86_64-unknown-linux-musl\"]; $names := $map($targets, function($t) { $prefix & $t & \".tar.gz\" }); $available := assets[name in $names and $contains(digest, /^sha256:[a-f0-9]{64}$/)]; $asset := $available[name = ($prefix & $target & \".tar.gz\")][0]; $count($available) = $count($targets) and $exists($asset) ? {\"version\": $v, \"digest\": $substringAfter($asset.digest, \"sha256:\"), \"releaseTimestamp\": published_at} : ()) ]})"
			]
		}
	}
}
