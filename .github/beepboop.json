{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "streams": {
    "kprint": {
      "versionScope": "none",
      "workflows": {
        "publish": {
          "file": "kprint-release.yml",
          "ref": "refs/heads/master",
          "mode": "dispatch",
          "publications": []
        }
      }
    }
  },
  "subscriptions": [
    {
      "id": "kprint-release",
      "source": "kjanat/kprint",
      "sourceStream": "main",
      "event": "release",
      "stream": "kprint",
      "operation": "publish"
    }
  ],
  "managers": [
    "workflow"
  ]
}
